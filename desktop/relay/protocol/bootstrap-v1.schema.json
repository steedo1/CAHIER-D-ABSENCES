{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mon-cahier.com/protocol/bootstrap-v1.schema.json",
  "title": "Mon Cahier Relay Bootstrap v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "snapshot_id",
    "institution_id",
    "generated_at",
    "institution",
    "entities"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "institution_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "cursor": { "type": ["string", "null"] },
    "institution": { "$ref": "#/$defs/entity" },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "academic_years": { "$ref": "#/$defs/entities" },
        "profiles": { "$ref": "#/$defs/entities" },
        "user_roles": { "$ref": "#/$defs/entities" },
        "classes": { "$ref": "#/$defs/entities" },
        "subjects": { "$ref": "#/$defs/entities" },
        "teacher_subjects": { "$ref": "#/$defs/entities" },
        "students": { "$ref": "#/$defs/entities" },
        "class_enrollments": { "$ref": "#/$defs/entities" },
        "institution_periods": { "$ref": "#/$defs/entities" },
        "teacher_timetables": { "$ref": "#/$defs/entities" },
        "teacher_absence_requests": { "$ref": "#/$defs/entities" },
        "teacher_sessions": { "$ref": "#/$defs/entities" },
        "attendance_marks": { "$ref": "#/$defs/entities" },
        "grade_periods": { "$ref": "#/$defs/entities" },
        "grade_evaluations": { "$ref": "#/$defs/entities" },
        "student_grades": { "$ref": "#/$defs/entities" },
        "textbook_assignments": { "$ref": "#/$defs/entities" },
        "textbook_items": { "$ref": "#/$defs/entities" },
        "textbook_sessions": { "$ref": "#/$defs/entities" },
        "textbook_completions": { "$ref": "#/$defs/entities" },
        "offline_documents": { "$ref": "#/$defs/entities" }
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "institution_id": { "type": "string", "minLength": 1 },
        "server_version": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    }
  }
}
