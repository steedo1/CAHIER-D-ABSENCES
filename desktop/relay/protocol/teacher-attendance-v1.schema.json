{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mon-cahier.com/protocol/teacher-attendance-v1.schema.json",
  "title": "Mon Cahier teacher attendance relay operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "operation_id",
    "operation_type",
    "session_id",
    "class_id",
    "period_id",
    "marks"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation_type": {
      "const": "attendance.call.submit"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "class_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "period_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "presence_proof": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "marks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "student_id",
          "status"
        ],
        "properties": {
          "student_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "enum": [
              "present",
              "absent",
              "late"
            ]
          },
          "comment": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "late_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  }
}
