{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@mon-cahier-finance-rules": ["../src/lib/finance/charge-rules.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../src/lib/finance/charge-rules.ts"]
}
